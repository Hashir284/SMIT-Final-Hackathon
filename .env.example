# ==============================
# HCM Lite - Backend Environment
# Copy to .env and fill values
# ==============================

PORT=8000
NODE_ENV=development

# MongoDB (required)
MONGO_URI=mongodb://127.0.0.1:27017/hcm-lite
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/hcm-lite

# JWT (required)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d
COOKIE_EXPIRE_DAYS=7

# Groq AI
GROQ_API_KEY=

# Google OAuth - Continue with Google
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web)
# 3. Origins: http://localhost:5173 , http://localhost:8000
GOOGLE_CLIENT_ID=
